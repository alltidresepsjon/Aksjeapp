# Database
DATABASE_URL="postgresql://borsliga:borsliga_dev_pw@localhost:5432/borsliga?schema=public"

# NextAuth / Auth.js
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Market data
# "mock" is the only supported provider in this MVP. See docs/marketdata.md
# for what is required to plug in a real, licensed data provider.
MARKET_DATA_PROVIDER="mock"
# Seed used to deterministically generate mock prices — keep stable in dev
# so prices don't jump around between restarts.
MOCK_MARKET_SEED="borsliga-demo-2026"
# How often (ms) the mock market "publishes" a new price tick per stock.
MOCK_MARKET_TICK_INTERVAL_MS="5000"
# Simulated feed latency (ms) — time between a tick's market-data timestamp
# and when it becomes observable to the app. Used to demonstrate the
# received-at vs market-data-timestamp distinction.
MOCK_MARKET_LATENCY_MS="500"

# Trading
# Simulated brokerage fee ("kurtasje"): flat NOK fee + percentage of trade value.
BROKERAGE_FLAT_FEE_NOK="39"
BROKERAGE_PERCENT_FEE="0.001"
# Max wall-clock time (ms) the server will wait for a fresh, valid price
# observation before rejecting/expiring an order.
ORDER_MAX_WAIT_MS="20000"
# Market opening hours (local Europe/Oslo time, 24h), Mon-Fri only in MVP.
MARKET_OPEN_HOUR="9"
MARKET_CLOSE_HOUR="17"

# Starting capital per user per competitive league season (NOK)
STARTING_CASH_NOK="100000"
