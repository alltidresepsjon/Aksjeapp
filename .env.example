# Database
DATABASE_URL="postgresql://aksjeanalyse:dev_local_pw@localhost:5432/aksjeanalyse?schema=public"

# Auth.js
# Generer med: npx auth secret
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Privat plattform: kun disse e-postadressene kan logge inn/registrere seg.
# Kommaseparert liste.
ALLOWED_EMAILS="deg@example.com"

# Hver konto har sin egen datakilde basert på kontoens modus (DEMO/PAPER/
# LIVE_READONLY) — se src/lib/market/index.ts. Kun DEMO (syntetiske data)
# er implementert i denne versjonen; PAPER krever en ekte, konfigurert
# leverandør (se docs/dataleverandorer.md) og feiler tydelig inntil da.
DEMO_MARKET_SEED="aksjeanalyse-demo"

# Basisvaluta for porteføljen (visning og regnskap)
BASE_CURRENCY="NOK"
# Simulert startkapital i basisvaluta
STARTING_CAPITAL="1000000"

# Simulerte handelskostnader (samme prinsipp som kurtasje i en tidligere
# leveranse — dokumentert og konfigurerbar, ikke skjult i koden)
BROKERAGE_FLAT_FEE="39"
BROKERAGE_PERCENT_FEE="0.001"
# Antatt spread/slippage som prosent av handelsverdien, lagt til
# utførelsesprisen (kjøp dyrere, salg billigere) — se docs/simulering.md
SLIPPAGE_PERCENT="0.0005"

# Kostnadstak — myke grenser appen selv håndhever, IKKE en erstatning for
# faktiske forbruksgrenser hos leverandørene. Se docs/kostnader.md.
MONTHLY_AI_BUDGET_NOK="300"
MONTHLY_DATA_BUDGET_NOK="200"

# Anthropic API-nøkkel for AI-analyse i selve appen (ADSKILT fra Claude Code
# sin egen tilgang — denne appen kaller Anthropic API-et direkte).
# Hent fra console.anthropic.com. ALDRI lim inn i chat — sett kun her/i
# Railway Variables.
ANTHROPIC_API_KEY=""
