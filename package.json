{
  "name": "bathtub-gin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/client",
    "packages/server"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm run dev -w @bg/client",
    "dev:server": "npm run dev -w @bg/server",
    "build": "npm run build -w @bg/client",
    "start": "npm run start -w @bg/server",
    "test": "vitest run",
    "typecheck": "tsc -p packages/shared && tsc -p packages/client && tsc -p packages/server",
    "shots": "node scripts/screenshots.mjs",
    "art": "node scripts/import-art.mjs",
    "art:clear": "node scripts/import-art.mjs --clear",
    "art:check": "node scripts/check-art.mjs",
    "art:templates": "node scripts/make-templates.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
